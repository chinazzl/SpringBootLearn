<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
    </parent>
    <groupId>org.simpleTemplate</groupId>
    <artifactId>springBootTemplatte</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Spring Boot 4 的 parent 已定义 java.version 与 maven.compiler.release，
             此处不要再写 maven.compiler.source/target，避免 release 与 source/target 冲突 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web：Spring Boot 4 中 spring-boot-starter-web 已废弃，统一用 webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Kafka：Spring Boot 4 把 Kafka 自动配置拆到了独立的 spring-boot-kafka 模块，
             只引入 spring-kafka 不会有 KafkaTemplate 自动装配（Boot 3 及以前在 spring-boot-autoconfigure 里）。
             改用 starter 才能拿到 KafkaAutoConfiguration。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus：Spring Boot 4 必须用 boot4 专用 starter。
             旧的 mybatis-plus-boot-starter 内部锁 mybatis-spring 2.1.2（面向 Spring 6 / Boot 2.7），
             在 Spring Framework 7 上会 NoSuchMethodError。
             boot4 starter 依赖 mybatis-spring 4.1.0 -> spring 7.0.8 / mybatis 3.5.19，与 Boot 4.1.1 对齐。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.18.1</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.alibaba.fastjson2/fastjson2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.10</version>
        </dependency>

        <!-- MySQL 驱动：旧的 mysql:mysql-connector-java 坐标已废弃，
             统一用 com.mysql:mysql-connector-j，版本由 spring-boot-dependencies BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- POI：hutool 5.8.x 的 hutool-poi 是按 POI 4.1.2 编译的，
             若强行升到 POI 5.x，ExcelUtil/ExcelWriter 运行期会 NoSuchMethodError。
             这里保持 4.1.2 与 hutool 对齐。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>4.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>4.1.2</version>
        </dependency>

        <!--Oracle 数据库驱动：JDK8 编译产物，JDK17+ 推荐 ojdbc11 -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.9.0.25.07</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.26</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
        </dependency>

        <!-- AOP：Spring Boot 4 中 spring-boot-starter-aop 已被移除（Central 上 4.x 返回 404），
             替代品是 spring-boot-starter-aspectj（含 spring-aop + aspectjweaver）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 国密算法(SM2/SM3/SM4)支持：Hutool 的 SM4/SM3 底层同样依赖 BouncyCastle；JDK17 请用 jdk18on -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- 数据库口令加密(国密 SM4)，application.yml 中的密文形如 SM4(base64) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 生成可执行 fat jar（java -jar 直接启动）；
                 同时产出 *.jar.original 原始 jar。
                 未配置时 mvn package 只产出普通 jar，没有 BOOT-INF/ 与 Main-Class，
                 无法 java -jar 运行。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.template.TemplateRunner</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
